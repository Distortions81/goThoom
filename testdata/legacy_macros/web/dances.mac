	"/pose angry \r" 
	"/pose bless \r" 
	"/pose angry \r" 

}

mash		
{
	"/action does the Mash!\r"
	"/pose attack west\r/pose leanleft\r/pose celebrate\r"
	"/pose akimbo\r"
	pause 1
	"/pose leanright\r"
	"/pose attack\r"
	"/pose akimbo\r"
	"/pose celebrate\r"
	"/pose bless \r"
	pause 5
	"/pose bow \r"
	pause 5
	"/pose sit \r"
}


