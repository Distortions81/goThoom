// Metadata
// Name: Dances
// Tags: social, emotes
// Desc: Dance commands and help.
// Author: Inu; Mash by Noivad
// Website: https://clump.clanlord.net/
// Update: https://clump.clanlord.net/library/index.php?title=Dances.mac
"/dc" 
{
LABEL dancer
	if @text != ""
		call @text
	else
		message "*This lets you dance one of the following:"
		pause 8
		message "aki = akimbo,"
		pause 8
		message "chik = chicken dance,"
		pause 8
		message "mash = noivad's mash (non spammy version),"
		pause 8
		message "rm = running man,"
		pause 8
		message "shuf = shuffle,"
		pause 8
		message "throb = janet jackson 'throb' inspired dance,"
		pause 8
		message "vog = madonna 'vogue' inspired dance."
	end if
end label
}

aki
{
	"/pose akimbo \r"
	pause 1
	"/pose attack left \r"
	pause 1
	"/pose leanleft \r"
	pause 1
	"/pose attack right \r"
	pause 1
	"/pose leanright \r"
	pause 1
	"/pose attack south \r"
	"/pose attack north \r"
	pause 1
	"/pose attack north \r"
	"/pose attack south \r"
	pause 1
	"/pose akimbo \r"
	pause 1
	"/pose attack right \r"
	pause 1
	"/pose leanright \r"
	pause 1
	"/pose attack left \r"
	pause 1
	"/pose leanleft \r"
	pause 1
	"/pose bless \r"
	pause 5
	"/pose bow \r"
	pause 5
	"/pose sit \r"
}

