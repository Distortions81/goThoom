//kage:unit pixels

package main

const MaxLights = 128
const MaxDarks = 128
const MaxLightShadows = 32
// Lights restore detail more aggressively near sources but never exceed base.
const BaseLightScale = 4
// Darkening strength per dark source; tuned to avoid over-darkening at low night levels
const DarkScale      = 1
// Additive glow-ball parameters
const HaloRadiusFrac    = 0.35
const BaseHaloStrength  = 0.3
// The old inverse-square tail never reached zero. Fade the final few percent
// smoothly, then skip the rest of that light's per-pixel work.
const LightCutoffStartSquared = 9
const LightCutoffEndSquared = 16
const HaloCutoffStartSquared = 4
const HaloCutoffEndSquared = 9
const InvHaloRadiusFracSquared = 1 / (HaloRadiusFrac * HaloRadiusFrac)

var (
    LightCount int
    DarkCount int
    LightGeometry [MaxLights]vec4
    LightColor [MaxLights]vec4
    LightEqualizedColor [MaxLights]vec4
    DarkGeometry [MaxDarks]vec4
    DarkParameters [MaxDarks]vec2
    ShadowCount int
    ShadowLightGeometry [MaxLightShadows]vec4
    ShadowLightColor [MaxLightShadows]vec4
    ShadowEqualizedLightColor [MaxLightShadows]vec4
    ShadowCasterGeometry [MaxLightShadows]vec4
    ShadowAxis [MaxLightShadows]vec2
    LightStrength float
    GlowStrength float
    NightFactor float
    MaxLightPlane float
    HasCharacterShadowMask float
    CharacterShadowMin vec2
    CharacterShadowMax vec2
)

func Fragment(dstPos vec4, texCoord vec2, color vec4) vec4 {
    // Base sprite color
    base := imageSrc0At(texCoord)
    // Source images can move within Ebitengine's backing textures. Keep all
    // lighting coordinates local to the source image rather than its backing.
    pixelPos := texCoord - imageSrc0Origin()
	if HasCharacterShadowMask > 0.5 &&
		pixelPos.x >= CharacterShadowMin.x && pixelPos.y >= CharacterShadowMin.y &&
		pixelPos.x < CharacterShadowMax.x && pixelPos.y < CharacterShadowMax.y {
		shadowPos := imageSrc0Origin() + pixelPos - CharacterShadowMin
		shadowAlpha := imageSrc1AtFromSrc0Pos(shadowPos).a
		base.rgb *= 1.0-shadowAlpha
	}

    // Accumulate darkening multiplicatively (subtractive only)
    preLightDim := 1.0
    postLightDim := 1.0
    for i := 0; i < MaxDarks; i++ {
        if i < DarkCount {
            geometry := DarkGeometry[i]
            parameters := DarkParameters[i]
            dx := pixelPos.x - geometry.x
            dy := pixelPos.y - geometry.y
            nd2 := (dx*dx + dy*dy) * geometry.z
            f := 1.0 / (1.0 + nd2)
            d := clamp(DarkScale*geometry.w*f, 0.0, 1.0) * parameters.x
            if parameters.y > MaxLightPlane {
                postLightDim *= 1.0 - d
            } else {
                preLightDim *= 1.0 - d
            }
        }
    }
    dimmedBase := base.rgb * preLightDim

    // Compute a scalar reveal factor and a normalized color mix for smoother blending.
    // This avoids per-channel "patchwork" reveals and blends light colors proportionally.
    sumW := 0.0
    sumC := vec3(0.0, 0.0, 0.0)
    sumCraw := vec3(0.0, 0.0, 0.0)
    halo := vec3(0.0, 0.0, 0.0)
    for i := 0; i < MaxLights; i++ {
        if i < LightCount {
            geometry := LightGeometry[i]
            dx := pixelPos.x - geometry.x
            dy := pixelPos.y - geometry.y
            nd2 := (dx*dx + dy*dy) * geometry.z
            if nd2 < LightCutoffEndSquared {
                cutoff := 1.0 - smoothstep(LightCutoffStartSquared, LightCutoffEndSquared, nd2)
                f := 1.0 / (1.0 + nd2)
                // Sharper falloff to localize light influence.
                f = f * f * cutoff
                w := clamp(BaseLightScale*LightStrength*f, 0.0, 10.0) * geometry.w
                sumW += w
                rgb := LightColor[i].rgb
                eqRGB := LightEqualizedColor[i].rgb
                sumC += w * eqRGB
                sumCraw += w * rgb

                // Accumulate the compact halo here instead of walking every
                // light again in a second full shader loop.
                haloND2 := nd2 * InvHaloRadiusFracSquared
                if haloND2 < HaloCutoffEndSquared {
                    haloCutoff := 1.0 - smoothstep(HaloCutoffStartSquared, HaloCutoffEndSquared, haloND2)
                    h := 1.0 / (1.0 + haloND2)
                    h = h * h * h * haloCutoff
                    halo += geometry.w * h * rgb
                }
            }
        }
    }

    // Remove only the contribution from the light that a character blocks.
    // Each soft cone starts at the character and widens away from its source.
    blockedHalo := vec3(0.0, 0.0, 0.0)
    if ShadowCount > 0 {
        blockedW := 0.0
        blockedC := vec3(0.0, 0.0, 0.0)
        blockedCraw := vec3(0.0, 0.0, 0.0)
        for i := 0; i < MaxLightShadows; i++ {
            if i < ShadowCount {
                lightGeometry := ShadowLightGeometry[i]
                dx := pixelPos.x - lightGeometry.x
                dy := pixelPos.y - lightGeometry.y
                nd2 := (dx*dx + dy*dy) * lightGeometry.z
                if nd2 < LightCutoffEndSquared {
                    axis := ShadowAxis[i]
                    casterGeometry := ShadowCasterGeometry[i]
                    behind := pixelPos - casterGeometry.xy
                    along := dot(behind, axis)
                    if along > 0.0 {
                        halfWidth := casterGeometry.z * (1.0 + along*casterGeometry.w)
                        perpendicular := abs(behind.x*axis.y - behind.y*axis.x)
                        edgeStart := halfWidth * 0.65
                        cone := 1.0 - smoothstep(edgeStart, halfWidth, perpendicular)
                        cutoff := 1.0 - smoothstep(LightCutoffStartSquared, LightCutoffEndSquared, nd2)
                        f := 1.0 / (1.0 + nd2)
                        f = f * f * cutoff
                        w := clamp(BaseLightScale*LightStrength*f, 0.0, 10.0) * lightGeometry.w * cone
                        rgb := ShadowLightColor[i].rgb
                        eqRGB := ShadowEqualizedLightColor[i].rgb
                        blockedW += w
                        blockedC += w * eqRGB
                        blockedCraw += w * rgb

                        haloND2 := nd2 * InvHaloRadiusFracSquared
                        if haloND2 < HaloCutoffEndSquared {
                            haloCutoff := 1.0 - smoothstep(HaloCutoffStartSquared, HaloCutoffEndSquared, haloND2)
                            haloFalloff := 1.0 / (1.0 + haloND2)
                            haloFalloff = haloFalloff * haloFalloff * haloFalloff * haloCutoff
                            blockedHalo += lightGeometry.w * haloFalloff * rgb * cone
                        }
                    }
                }
            }
        }
        sumW = max(sumW - blockedW, 0.0)
        sumC = max(sumC - blockedC, vec3(0.0, 0.0, 0.0))
        sumCraw = max(sumCraw - blockedCraw, vec3(0.0, 0.0, 0.0))
    }

    // Tone map reveal to [0, 1) with a Reinhard-like curve
    reveal := sumW / (1.0 + sumW)
    // Gate reveal by night, reaching full power at 50% night
    nf := clamp(NightFactor, 0.0, 1.0)
    revealNF := clamp(nf * 2.0, 0.0, 1.0)
    reveal = reveal * revealNF

    // Normalized light color mix; default to white if no light
    mixColor := vec3(1.0, 1.0, 1.0)
    tintStrength := 0.6
    if sumW > 0.0001 {
        // If the combined light is close to neutral white, reduce chroma equalization
        // to let white mix more naturally with colored lights.
        rawMix := sumCraw / sumW
        cmax := max(rawMix.r, max(rawMix.g, rawMix.b))
        cmin := min(rawMix.r, min(rawMix.g, rawMix.b))
        avg := (rawMix.r + rawMix.g + rawMix.b) / 3.0
        // A crude saturation proxy; higher means more chroma, lower means whiter
        sat := 0.0
        if avg > 0.0001 {
            sat = clamp((cmax - cmin) / avg, 0.0, 1.0)
        }
        whiteness := 1.0 - sat
        // Blend between equalized and raw sums based on whiteness
        sumAdj := mix(sumC, sumCraw, whiteness)
        mixColor = sumAdj / sumW
        tintStrength = mix(tintStrength, 0.45, whiteness)
    }

    // Limit tint strength so base palette remains readable
    // Reduce tinting when overall light is very white to avoid washing colors.
    tintedBase := base.rgb * mix(vec3(1.0, 1.0, 1.0), mixColor, tintStrength)

    // Reveal from darkened color toward tinted base using scalar reveal
    finalRGB := mix(dimmedBase, tintedBase, reveal)

    // Tone-map the halo accumulated in the main light loop.
    halo = halo / (1.0 + halo)
    blockedHalo = blockedHalo / (1.0 + blockedHalo)
    halo = max(halo - blockedHalo, vec3(0.0, 0.0, 0.0))
    finalRGB = clamp(finalRGB + BaseHaloStrength*GlowStrength*halo, 0.0, 1.0)

    // Darkness on a lighting plane above every active light is composited
    // after light reveal and glow, matching the original lightmap ordering.
    finalRGB *= postLightDim

    return vec4(finalRGB, base.a)
}
