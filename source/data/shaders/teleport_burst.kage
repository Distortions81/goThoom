//kage:unit pixels

package main

var Size vec2
var CanvasSize vec2
var Phase float
var Alpha float
var Energy float
var HasMask float
var SpriteLightOnly float
var TeleportTheme float

func band(value, center, width float) float {
	return max(0, 1-abs(value-center)/width)
}

func spark(value float) float {
	v := max(0, sin(value))
	v *= v
	return v * v
}

func teleportColor(v float) vec3 {
	if TeleportTheme < 0.5 {
		return mix(vec3(1.0, 0.24, 0.005), vec3(1.0, 0.94, 0.34), v)
	}
	if TeleportTheme < 1.5 {
		return mix(vec3(0.05, 0.08, 1.0), vec3(0.48, 0.88, 1.0), v)
	}
	// The original third variant is multicolored; cycle cyan, magenta, and gold.
	cyan := vec3(0.08, 0.95, 1.0)
	magenta := vec3(1.0, 0.12, 0.78)
	gold := vec3(1.0, 0.84, 0.06)
	return mix(mix(cyan, magenta, 0.5+0.5*sin(Phase*7.0+v*5.0)), gold, 0.5+0.5*sin(Phase*5.0-v*7.0))
}

func Fragment(_ vec4, srcPos vec2, _ vec4) vec4 {
	localPos := srcPos - imageSrc0Origin()
	p := (localPos-CanvasSize*0.5)/Size
	p.x *= Size.x / Size.y
	t := Phase
	life := max(0, 1-t*0.60)

	if SpriteLightOnly > 0.5 {
		if HasMask <= 0.5 {
			return vec4(0, 0, 0, 0)
		}
		body := imageSrc0At(srcPos).a
		edge := max(imageSrc0At(srcPos+vec2(2, 0)).a, imageSrc0At(srcPos+vec2(0, 2)).a) - body
		pulse := 0.45 + 0.55*spark(t*12.0+p.y*15.0)
		light := max(0, body*(0.12+0.19*pulse)+edge*0.20) * life * Alpha
		color := teleportColor(pulse)
		return vec4(color*light, light)
	}

	// Compact, broken light shafts preserve the original teleport silhouette.
	// Their tiny offsets and the surrounding streams keep the shape energized.
	barA := max(0, 1-abs(p.x+0.075+sin(t*8.0)*0.015)/0.032)
	barA *= max(0, 1-abs(p.y-0.14)/0.18)
	barB := max(0, 1-abs(p.x-0.010+sin(t*6.0+1.7)*0.014)/0.038)
	barB *= max(0, 1-abs(p.y+0.015)/0.24)
	barC := max(0, 1-abs(p.x-0.090+sin(t*7.0+3.2)*0.013)/0.028)
	barC *= max(0, 1-abs(p.y+0.16)/0.16)
	bars := (barA+barB*1.15+barC*0.88) * (0.40+0.60*spark(p.y*31.0-t*19.0))
	// A compact glow-beam unifies the separate shafts without restoring the
	// full-height column of the first pass.
	glowBeam := max(0, 1-abs(p.x)/0.20)
	glowBeam *= max(0, 1-abs(p.y)/0.34)
	glowBeam *= 0.18 + 0.16*spark(p.y*15.0+t*10.0)
	streamA := vec2(sin(t*7.0+0.3)*(0.10+t*0.14), 0.30-t*0.62)
	streamB := vec2(sin(-t*6.0+1.8)*(0.15+t*0.09), 0.22-t*0.54)
	streamC := vec2(sin(t*9.0+3.2)*(0.07+t*0.17), 0.36-t*0.72)
	streamD := vec2(sin(-t*5.0+4.7)*(0.18-t*0.04), 0.13-t*0.45)
	streamE := vec2(sin(t*11.0+5.4)*(0.06+t*0.12), 0.40-t*0.80)
	a := band(length(p-streamA), 0.026+t*0.028, 0.024) * spark(p.x*27.0+p.y*19.0-t*21.0)
	b := band(length(p-streamB), 0.021+t*0.024, 0.020) * spark(p.x*35.0-p.y*23.0+t*25.0)
	c := band(length(p-streamC), 0.018+t*0.021, 0.017) * spark(p.x*43.0+p.y*31.0-t*29.0)
	d := band(length(p-streamD), 0.015+t*0.020, 0.015) * spark(p.x*51.0-p.y*37.0+t*33.0)
	e := band(length(p-streamE), 0.012+t*0.018, 0.013) * spark(p.x*59.0+p.y*41.0-t*39.0)
	// Fine ember curls fill the space between the larger teleport streams.
	embersA := band(length(p-vec2(sin(t*10.0)*0.20, cos(t*10.0)*0.14)), 0.020, 0.014) * spark(p.x*67.0-p.y*47.0+t*43.0)
	embersB := band(length(p-vec2(sin(-t*8.0+2.4)*0.17, cos(-t*8.0+2.4)*0.18)), 0.015, 0.012) * spark(p.x*73.0+p.y*53.0-t*49.0)
	embersC := band(length(p-vec2(sin(t*12.0+4.0)*0.13, cos(t*12.0+4.0)*0.21)), 0.012, 0.011) * spark(p.x*79.0-p.y*59.0+t*55.0)
	flare := max(0, 1-length(vec2(p.x*1.6, p.y*0.72))*2.7-t*1.8) * (0.35+0.28*spark(p.x*17.0+t*9.0))
	intensity := min(1, (bars*1.65+glowBeam+a*2.05+b*1.75+c*1.45+d*1.18+e+embersA*0.82+embersB*0.70+embersC*0.58+flare*1.20)*life)

	if HasMask > 0.5 {
		body := imageSrc0At(srcPos).a
		intensity *= 1.0-body*0.43
	}
	if intensity <= 0 {
		return vec4(0, 0, 0, 0)
	}
	color := teleportColor(min(1, intensity*1.5))
	aOut := min(1, intensity*2.8) * Alpha
	return vec4(color*aOut, aOut)
}
