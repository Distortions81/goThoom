//kage:unit pixels

package main

// Fragment applies only the additional darkness needed to advance from the
// previously composited maximum shadow opacity to the new maximum. The blend
// unit multiplies the scene by this factor and preserves destination alpha,
// avoiding a scene texture copy while retaining each caster's painter order.
func Fragment(dstPos vec4, texCoord vec2, color vec4) vec4 {
	previous := imageSrc0At(texCoord).a
	incoming := imageSrc1AtFromSrc0Pos(texCoord).a
	combined := max(previous, incoming)
	remaining := 1.0 - previous
	factor := 1.0
	if remaining > 0.0001 {
		factor = clamp((1.0-combined)/remaining, 0.0, 1.0)
	}
	return vec4(factor, factor, factor, 1.0)
}
