//kage:unit pixels

package main

var Size vec2
var Phase float
var Alpha float
var Energy float
var HasMask float
var MaskOffset vec2
var MaskInvScale float
var SpriteLightOnly float

func band(value, center, width float) float {
	return max(0, 1-abs(value-center)/width)
}

func mote(value float) float {
	// Turn a sinusoid into a compact point without a discontinuous threshold.
	v := max(0, sin(value))
	v *= v
	v *= v
	return v * v
}

func polarAngle(p vec2) float {
	// Kage has only atan(x), so restore atan2's missing quadrants explicitly.
	angle := atan(p.y / (abs(p.x) + 0.0001))
	if p.x < 0 {
		if p.y >= 0 {
			return 3.14159265 - angle
		}
		return -3.14159265 - angle
	}
	return angle
}

func maskAlpha(localPos vec2) float {
	return imageSrc0At(imageSrc0Origin()+(localPos-MaskOffset)*MaskInvScale).a
}

func Fragment(_ vec4, srcPos vec2, _ vec4) vec4 {
	// A continuous version of the original 1759 healing animation: a blue core
	// blooms into evenly spaced cyan motes, then settles back into the caster.
	// The legacy frames have a distinctly radial, dotted silhouette, so keep
	// that readable before adding only a little motion between the frames.
	windScale := 0.68 + 0.32*Energy
	localPos := srcPos - imageSrc0Origin()
	p := (localPos/Size - vec2(0.5, 0.5)) / windScale
	p.x *= Size.x / Size.y
	r := length(p)
	angle := polarAngle(p)
	// Interpolate the old four-frame pulse over a little more than one second.
	// Its smooth return makes a sustained heal feel active without becoming a
	// fast, unrelated particle storm.
	t := Phase
	pulse := 0.5 - 0.5*cos(t*5.1)

	// Illuminate only the opaque pixels of the pinned mobile in a dedicated
	// additive pass. Moving bands and the brighter inner rim make the light
	// feel like it is traveling around the body instead of applying a flat tint.
	if SpriteLightOnly > 0.5 {
		if HasMask <= 0.5 {
			return vec4(0, 0, 0, 0)
		}
		body := maskAlpha(localPos)
		rightAlpha := maskAlpha(localPos+vec2(2, 0))
		leftAlpha := maskAlpha(localPos+vec2(-2, 0))
		downAlpha := maskAlpha(localPos+vec2(0, 2))
		upAlpha := maskAlpha(localPos+vec2(0, -2))
		insideAlpha := min(rightAlpha, min(leftAlpha, min(downAlpha, upAlpha)))
		innerEdge := max(0, body-insideAlpha)
		arcaneWave := 0.5 + 0.5*sin(t*3.1-p.y*11.0+angle*2.0)
		centerLight := max(0, 1-r*1.35)
		light := body*(0.10+0.16*arcaneWave+0.13*centerLight)
		light += innerEdge*(0.20+0.11*arcaneWave)
		light *= Alpha
		color := mix(vec3(0.02, 0.16, 0.88), vec3(0.30, 0.94, 1.0), arcaneWave*0.65+innerEdge*0.35)
		return vec4(color*light, light)
	}

	// The two broad rings reproduce the 1759 frames' dotted cyan flower.
	// A slightly offset middle ring prevents the procedural interpolation from
	// looking too mechanically perfect.
	innerRadius := 0.12 + pulse*0.15
	outerRadius := 0.20 + pulse*0.31
	innerDots := band(r, innerRadius, 0.019) * mote(angle*12.0+t*1.1+r*9.0)
	outerDots := band(r, outerRadius, 0.018) * mote(angle*18.0-t*0.75+r*12.0)
	middleDots := band(r, 0.16+pulse*0.27, 0.013) * mote(angle*24.0+t*1.7)

	// Tiny flecks bridge the rings as the bloom grows. They add depth without
	// obscuring the familiar, clean dotted outline.
	fleckRadius := 0.09 + pulse*0.47
	flecks := band(r, fleckRadius, 0.010) * mote(angle*31.0-t*2.6+r*16.0)
	core := max(0, 1-r*(8.8-pulse*2.2)) * (0.68+0.32*pulse)
	innerGlow := max(0, 1-r*3.4) * (0.07+0.10*pulse)
	// A restrained eight-point glimmer is the embellishment: it appears only
	// near the peak, behind the cyan motes, and never reads as a hard sigil.
	star := band(r, outerRadius*0.72, 0.022) * mote(angle*8.0-t*0.45) * pulse * 0.28
	intensity := min(1, core + innerGlow + 1.32*innerDots + 1.55*outerDots + 0.72*middleDots + 0.58*flecks + star)

	// Use the nearby player's alpha silhouette as a depth mask. A slowly
	// rotating depth wave lets some motes pass in front while most recede
	// behind the body, and a soft alpha edge catches extra healing light.
	if HasMask > 0.5 {
		body := maskAlpha(localPos)
		rightAlpha := maskAlpha(localPos+vec2(2, 0))
		leftAlpha := maskAlpha(localPos+vec2(-2, 0))
		downAlpha := maskAlpha(localPos+vec2(0, 2))
		upAlpha := maskAlpha(localPos+vec2(0, -2))
		edgeAlpha := max(rightAlpha, max(leftAlpha, max(downAlpha, upAlpha)))
		edge := max(0, edgeAlpha-body)
		insideAlpha := min(rightAlpha, min(leftAlpha, min(downAlpha, upAlpha)))
		innerEdge := max(0, body-insideAlpha)
		depth := 0.5 + 0.5*sin(angle*3.0+r*13.0-t*1.7)
		front := smoothstep(0.58, 0.88, depth)
		bodyVisibility := 0.16 + 0.84*front
		intensity *= mix(1.0, bodyVisibility, body)
		intensity += edge*max(0, 1-r*1.7)*0.42
		// Leave just enough body light in this pass to visually join the motes
		// to the dedicated additive sprite-light pass.
		bodyPulse := 0.5 + 0.5*sin(t*3.1-r*7.0)
		bodyGlow := body*max(0, 1-r*1.55)*(0.030+0.035*bodyPulse)
		intensity += bodyGlow + innerEdge*0.12
		intensity = min(1, intensity)
	}
	if intensity <= 0 {
		return vec4(0, 0, 0, 0)
	}

	// The effect is composited after scene lighting. Boost its opacity here so
	// thin rings retain an emissive, full-bright read against dusk-darkened art.
	color := mix(vec3(0.02, 0.16, 0.95), vec3(0.36, 0.98, 1.0), min(1, intensity*1.85))
	a := min(1, intensity*2.10) * Alpha
	return vec4(color*a, a)
}
