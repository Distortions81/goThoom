//kage:unit pixels

package main

var Size vec2
var Phase float
var Alpha float
var Energy float
var HasMask float
var SpriteLightOnly float

func band(value, center, width float) float {
	return max(0, 1-abs(value-center)/width)
}

func spark(value float) float {
	v := max(0, sin(value))
	v *= v
	return v * v
}

func polarAngle(p vec2) float {
	angle := atan(p.y / (abs(p.x) + 0.0001))
	if p.x < 0 {
		if p.y >= 0 {
			return 3.14159265 - angle
		}
		return -3.14159265 - angle
	}
	return angle
}

func Fragment(_ vec4, srcPos vec2, _ vec4) vec4 {
	localPos := srcPos - imageSrc0Origin()
	p := localPos/Size - vec2(0.5, 0.5)
	p.x *= Size.x / Size.y
	r := length(p)
	angle := polarAngle(p)
	// Phase is the effect's age, not a global clock: every protection burst
	// begins at its own center and dissipates naturally.
	t := Phase

	// A gold ward softly lights the protected character without obscuring it.
	if SpriteLightOnly > 0.5 {
		if HasMask <= 0.5 {
			return vec4(0, 0, 0, 0)
		}
		body := imageSrc0At(srcPos).a
		edge := max(imageSrc0At(srcPos+vec2(2, 0)).a, imageSrc0At(srcPos+vec2(0, 2)).a) - body
		pulse := 0.55 + 0.45*sin(t*9.0-angle*2.0)
		light := max(0, body*(0.14+0.22*pulse)+edge*0.24) * max(0, 1-t*0.60) * Alpha
		color := mix(vec3(0.95, 0.18, 0.01), vec3(1.0, 0.80, 0.20), pulse)
		return vec4(color*light, light)
	}

	// An irregular, upward-biased poof of embers. Each swarm has its own
	// drifting center so it reads as a cloud of sparks rather than a line.
	life := max(0, 1-t*0.72)
	clusterA := vec2(cos(t*4.2+0.3)*(0.08+t*0.12)-0.10, sin(t*4.2+0.3)*(0.05+t*0.07)+0.09-t*0.26)
	clusterB := vec2(cos(-t*3.5+2.0)*(0.10+t*0.10)+0.12, sin(-t*3.5+2.0)*(0.06+t*0.08)+0.10-t*0.21)
	clusterC := vec2(cos(t*5.1+4.1)*(0.06+t*0.16), sin(t*5.1+4.1)*(0.04+t*0.10)-0.02-t*0.32)
	emberA := band(length(p-clusterA), 0.018+t*0.040, 0.024) * spark(angle*13.0-t*9.0)
	emberB := band(length(p-clusterB), 0.015+t*0.035, 0.021) * spark(angle*19.0+t*12.0+1.4)
	emberC := band(length(p-clusterC), 0.012+t*0.030, 0.018) * spark(angle*27.0-t*14.0+2.7)
	// A fourth, short-lived spray gives the first frame a fuller magical pop.
	clusterD := vec2(cos(-t*6.3+1.0)*(0.04+t*0.17)-0.02, sin(-t*6.3+1.0)*(0.03+t*0.11)+0.04-t*0.15)
	emberD := band(length(p-clusterD), 0.009+t*0.046, 0.016) * spark(angle*31.0+t*16.0)
	clusterE := vec2(cos(t*4.7+3.4)*(0.05+t*0.14)-0.18, sin(t*4.7+3.4)*(0.04+t*0.09)+0.12-t*0.18)
	clusterF := vec2(cos(-t*5.4+5.0)*(0.05+t*0.13)+0.19, sin(-t*5.4+5.0)*(0.04+t*0.09)+0.07-t*0.24)
	emberE := band(length(p-clusterE), 0.007+t*0.037, 0.013) * spark(angle*37.0-t*18.0+0.6)
	emberF := band(length(p-clusterF), 0.006+t*0.035, 0.012) * spark(angle*41.0+t*20.0+2.3)
	// Fine cinders fill the gaps between the larger sprays without forming a ring.
	cinders := max(0, 1-r*2.5-t*1.45) * spark(angle*47.0+r*31.0-t*22.0)
	burst := max(0, 1-r*4.2-t*1.8) * (0.56+0.34*spark(angle*9.0+t*7.0))
	smoke := max(0, 1-length(vec2(p.x*1.15, p.y+t*0.18))*1.75) * 0.22
	intensity := min(1, (emberA*1.85+emberB*1.45+emberC*1.15+emberD+emberE*0.92+emberF*0.85+cinders*0.48+burst+smoke)*life)

	if HasMask > 0.5 {
		body := imageSrc0At(srcPos).a
		edge := max(imageSrc0At(srcPos+vec2(2, 0)).a, imageSrc0At(srcPos+vec2(0, 2)).a) - body
		depth := 0.48 + 0.52*sin(angle*2.0-r*15.0-t*4.0)
		intensity *= mix(1.0, 0.28+0.65*depth, body)
		intensity += max(0, edge)*0.22
	}
	if intensity <= 0 {
		return vec4(0, 0, 0, 0)
	}

	color := mix(vec3(1.0, 0.095, 0.003), vec3(1.0, 0.94, 0.40), min(1, intensity*1.65))
	a := min(1, intensity*3.05) * Alpha
	return vec4(color*a, a)
}
